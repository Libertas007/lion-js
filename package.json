{
    "name": "lion-parser",
    "version": "2.0.1",
    "description": "Libertas Object Notation parser",
    "main": "./dist/main.js",
    "types": "./dist/main.d.ts",
    "files": [
        "./dist"
    ],
    "exports": {
        ".": {
            "bun": {
                "types": "./dist/platform/bun.d.ts",
                "default": "./dist/platform/bun.js"
            },
            "deno": {
                "types": "./dist/platform/deno.d.ts",
                "default": "./dist/platform/deno.js"
            },
            "node": {
                "types": "./dist/platform/node.d.ts",
                "default": "./dist/platform/node.js"
            },
            "default": {
                "types": "./dist/main.d.ts",
                "default": "./dist/main.js"
            }
        }
    },
    "author": "Libertas",
    "license": "MIT",
    "scripts": {
        "build": "tsc"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Libertas007/lion-js"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "typescript": "^5.4.5",
        "@types/node": "^22.13.1"
    }
}
